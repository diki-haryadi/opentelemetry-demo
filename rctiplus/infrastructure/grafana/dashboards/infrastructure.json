{
  "title": "Infrastructure (Production)",
  "tags": ["production", "infra"],
  "panels": [
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(container_cpu_usage_seconds_total[1m])) by (container_name)",
        "legendFormat": "{{container_name}}",
        "refId": "A"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "Memory Usage",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "container_memory_usage_bytes",
        "legendFormat": "{{container_name}}",
        "refId": "A"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "title": "Network Traffic",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "rate(container_network_receive_bytes_total[1m])",
        "legendFormat": "{{container_name}}",
        "refId": "A"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "title": "Disk I/O",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "rate(container_fs_reads_bytes_total[1m])",
        "legendFormat": "{{container_name}}",
        "refId": "A"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ]
}
