# Example Terraform variables file
# Copy this file to terraform.tfvars and customize for your environment

# Kubernetes Configuration
# kubeconfig_path = "~/.kube/config"
# kube_context    = ""  # Leave empty to use current context, or specify: "docker-desktop", "minikube", "kind-otel-demo"

# OpenTelemetry Demo Configuration
namespace    = "otel-demo"
release_name = "opentelemetry-demo"

# Service Type
# - ClusterIP: Only accessible within the cluster (use with kubectl port-forward)
# - NodePort: Accessible on a port on each cluster node
# - LoadBalancer: Creates an external load balancer (cloud providers only)
service_type = "ClusterIP"

# Chart Version (leave empty for latest)
# chart_version = "0.32.0"

# Resource Limits
resource_limits_enabled = false
# default_memory_limit    = "512Mi"
# default_cpu_limit       = "500m"

# Custom Helm Settings
# custom_settings = {
#   "default.replicas" = "2"
# }
