      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(calls_total[$__rate_interval]))",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
